{
  "name": "@fa/api",
  "version": "2.0.0",
  "private": true,
  "description": "French Academy API — Express 5 + PostgreSQL. Serves /api/* and the protected /content/* JSON.",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node scripts/check-content.js",
    "build:tests": "node scripts/build-tests.js",
    "db:setup": "node --env-file=.env scripts/db-setup.js",
    "db:psql": "node --env-file=.env scripts/psql.js",
    "db:import": "tsx --env-file=.env src/import-json.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "nodemailer": "^10.0.11",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@fa/shared": "*",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
