# API settings (read by api/). `npm run db:setup` creates the role + databases named in DATABASE_URL.
API_PORT=4000
# Set COOKIE_SECURE=true only when served over HTTPS.
COOKIE_SECURE=false
# postgres://USER:PASSWORD@HOST:PORT/DATABASE — use a long random password (hex is URL-safe).
DATABASE_URL=postgres://french_academy:CHANGE_ME_long_random_hex@localhost:5432/french_academy
# PGSSL=true            # for hosted Postgres that requires TLS (Neon, Supabase…)
# --- Hosting (see docs/DEPLOY-FREE.md) ---
# API_HOST=0.0.0.0      # listen on all interfaces (default 127.0.0.1 = only the local Next.js server)
# TRUST_PROXY=true      # behind a hosting proxy (Render): trust X-Forwarded-* so HTTPS cookies work
# PORT                  # set by the host; leave API_PORT unset there
# PG_SUPERUSER=postgres # superuser used by npm run db:setup
# Optional provider keys (Admin-stored keys take precedence):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
